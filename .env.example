# Database
DATABASE_URL=postgresql://docket:docket_dev@localhost:5432/docket_db

# Flask
FLASK_APP=docket.web:create_app()
FLASK_ENV=development
SECRET_KEY=generate-a-secure-key-here

# Domain
DOMAIN_NAME=docket.pub

# Admin contact email — surfaced in citizen-facing templates as a mailto:
# target for "report missing data" links.
ADMIN_EMAIL=admin@docket.pub

# AI pipeline
ANTHROPIC_API_KEY=
AI_ITEM_MODEL=claude-haiku-4-5-20251001
AI_MEETING_MODEL=claude-sonnet-4-6
AI_DAILY_BUDGET_USD=10
AI_MAX_BATCH_SIZE=200

# Email alerts (Phase 6 — not needed yet)
# SENDGRID_API_KEY=your_key
# ALERT_EMAIL_TO=you@example.com
# ALERT_EMAIL_FROM=alerts@docket.pub

# Meeting transcripts, plan 2 (worker service unless noted; see docs/runbooks/transcripts.md)
# Model for speaker resolution (default claude-sonnet-5-5)
AI_TRANSCRIPT_SPEAKER_MODEL=claude-sonnet-5-5
# Model for event extraction; stays Sonnet 5.5 per the Haiku A/B
AI_TRANSCRIPT_EVENTS_MODEL=claude-sonnet-5-5
# Model for aligner judge and hunter
AI_TRANSCRIPT_COMPARE_MODEL=claude-opus-5-5
# Model used only by scripts/transcript_extraction_ab.py
AI_TRANSCRIPT_AB_MODEL=claude-haiku-4-5-20251001
# Input-token ceiling per call; a breach sends the transcript to needs_review
TRANSCRIPT_TOKEN_CEILING=500000
# Max discrepancy candidates per meeting before the transcript goes to needs_review
TRANSCRIPT_CANDIDATE_CAP=40
# Transcripts advanced one stage per daily tick
TRANSCRIPT_PER_TICK=5
# Word-count floor; below it a transcript is low_speech
TRANSCRIPT_MIN_WORDS=300
# Slack or Discord incoming webhook for failed/needs_review/stalled-desktop alerts; unset = silent
ALERT_WEBHOOK_URL=
# Healthchecks.io check UUID for transcript_pipeline (daily, grace 2h); unset = no ping
HEALTHCHECK_TRANSCRIPT_PIPELINE_UUID=
# Healthchecks.io check UUID for resolve_member_votes (daily 08:45, grace 2h); unset = no ping
HEALTHCHECK_RESOLVE_MEMBER_VOTES_UUID=
# Web service only: show the public "Minutes vs. Video" block and /minutes-vs-video/ (leave unset until the ship gate reads "met")
MINUTES_VS_VIDEO_UI=
